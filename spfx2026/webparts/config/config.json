{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "hello-world-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/helloWorld/HelloWorldWebPart.js",
          "manifest": "./src/webparts/helloWorld/HelloWorldWebPart.manifest.json"
        }
      ]
    },
    "faq-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/faq/FaqWebPart.js",
          "manifest": "./src/webparts/faq/FaqWebPart.manifest.json"
        }
      ]
    },
    "navbar-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/navbar/NavbarWebPart.js",
          "manifest": "./src/webparts/navbar/NavbarWebPart.manifest.json"
        }
      ]
    },
    "menu-lateral-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/menuLateral/MenuLateralWebPart.js",
          "manifest": "./src/webparts/menuLateral/MenuLateralWebPart.manifest.json"
        }
      ]
    },
    "lista-novedades-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/listaNovedades/ListaNovedadesWebPart.js",
          "manifest": "./src/webparts/listaNovedades/ListaNovedadesWebPart.manifest.json"
        }
      ]
    },
    "organigrama-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/organigrama/OrganigramaWebPart.js",
          "manifest": "./src/webparts/organigrama/OrganigramaWebPart.manifest.json"
        }
      ]
    },
    "footer-application-customizer": {
      "components": [
        {
          "entrypoint": "./lib/extensions/footer/FooterApplicationCustomizer.js",
          "manifest": "./src/extensions/footer/FooterApplicationCustomizer.manifest.json"
        }
      ]
    },
    "tabla-doc-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/tablaDoc/TablaDocWebPart.js",
          "manifest": "./src/webparts/tablaDoc/TablaDocWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "HelloWorldWebPartStrings": "lib/webparts/helloWorld/loc/{locale}.js",
    "FaqWebPartStrings": "lib/webparts/faq/loc/{locale}.js",
    "PropertyControlStrings": "node_modules/@pnp/spfx-property-controls/lib/loc/{locale}.js",
    "NavbarWebPartStrings": "lib/webparts/navbar/loc/{locale}.js",
    "MenuLateralWebPartStrings": "lib/webparts/menuLateral/loc/{locale}.js",
    "ListaNovedadesWebPartStrings": "lib/webparts/listaNovedades/loc/{locale}.js",
    "OrganigramaWebPartStrings": "lib/webparts/organigrama/loc/{locale}.js",
    "FooterApplicationCustomizerStrings": "lib/extensions/footer/loc/{locale}.js",
    "TablaDocWebPartStrings": "lib/webparts/tablaDoc/loc/{locale}.js"
  }
}
